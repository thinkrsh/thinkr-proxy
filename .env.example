# The proxy reads these variables at startup and stops when one is missing or invalid.
# Keys live in secret/ at the root of the workspace, never in this folder:
# OPENROUTER_API_KEY in secret/openrouter.env, TINFOIL_API_KEY in secret/tinfoil.env.
OPENROUTER_API_KEY=
TINFOIL_API_KEY=
# Settings live in env/: dev.env (full) on the laptop, trial.env for the free trial (decision 67).
# full | trial
ACCESS_MODE=
# Optional. The header with the address of the visitor behind a proxy, such as CF-Connecting-IP.
CLIENT_ADDRESS_HEADER=
# The public key (PEM) of the vouchers that the issuer signs: secret/voucher-dev-public.pem on the
# laptop (env/local.env), /etc/thinkr/voucher-public-key.pem on the server (env/server.env).
VOUCHER_PUBLIC_KEY_FILE=
# The public keys of holder vouchers, one for each month, as JSON from npm run holder-keys -- public
# of apps/issuer: secret/holder-public-keys-dev.json on the laptop,
# /etc/thinkr/holder-public-keys.json on the server.
HOLDER_PUBLIC_KEYS_FILE=
# The public keys of the notes of change, from `npm run change-keys -- public <folder>` of apps/issuer.
# Unset, the proxy takes no note of change: no coin of top-ups is open.
# CHANGE_PUBLIC_KEYS_FILE=
# The secret that seals the tickets of video jobs, 32 bytes in base64url: secret/ticket-key-dev.txt on
# the laptop, /etc/thinkr/ticket-key.txt on the server.
TICKET_KEY_FILE=
# The SQLite file of the ledger of credit.
DATABASE_FILE=
# Optional. The public HTTPS address of the proxy, such as https://chat.thinkr.sh, where a provider
# fetches the source of a video edit, an upscale, or a talking photo. Unset, none of them starts.
PUBLIC_ORIGIN=
