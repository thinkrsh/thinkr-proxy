# Settings of the proxy on the laptop of the owner, loaded by npm run dev, dev:trial, and start.
# Not secret: the files that it names live in secret/, and the ledger in .data/. The public key is
# that of secret/voucher-dev.pem, which signs the vouchers of the issuer on the laptop.
VOUCHER_PUBLIC_KEY_FILE=../../secret/voucher-dev-public.pem
HOLDER_PUBLIC_KEYS_FILE=../../secret/holder-public-keys-dev.json
PASS_PUBLIC_KEYS_FILE=../../secret/pass-public-keys-dev.json
TICKET_KEY_FILE=../../secret/ticket-key-dev.txt
DATABASE_FILE=.data/ledger.db
CHANGE_PUBLIC_KEYS_FILE=../../secret/change-public-keys-dev.json
