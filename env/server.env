# The settings of the proxy on the server, behind Cloudflare and Caddy (decision 67). Not secret.
# Cloudflare puts the address of the visitor in this header; the server takes requests from Cloudflare only.
CLIENT_ADDRESS_HEADER=CF-Connecting-IP
# The public key of the vouchers, derived from secret/voucher-key.pem by scripts/chat/deploy.sh keys.
VOUCHER_PUBLIC_KEY_FILE=/etc/thinkr/voucher-public-key.pem
# The public keys of holder vouchers, one for each month, from secret/holder-keys/ by the same part.
HOLDER_PUBLIC_KEYS_FILE=/etc/thinkr/holder-public-keys.json
# The public keys of the passes of free chats, one for each month, from secret/pass-keys/ by the same part.
PASS_PUBLIC_KEYS_FILE=/etc/thinkr/pass-public-keys.json
CHANGE_PUBLIC_KEYS_FILE=/etc/thinkr/change-public-keys.json
# The secret that seals the tickets of video jobs, piped from secret/ticket-key.txt by the same part.
TICKET_KEY_FILE=/etc/thinkr/ticket-key.txt
# The ledger of credit, in the state folder that systemd gives the proxy (StateDirectory).
DATABASE_FILE=/var/lib/thinkr-proxy/ledger.db
# The public address of the proxy, where a provider fetches the source of a video edit, an upscale,
# or a talking photo (decision 216). The laptop has none, so no sourced video starts there.
PUBLIC_ORIGIN=https://chat.thinkr.sh
